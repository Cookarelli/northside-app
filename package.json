{
  "name": "northside-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.mjs && node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:privacy": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "format": "prettier --write app components lib tests scripts/*.mjs *.json *.ts *.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "staff:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-owner.mjs",
    "orders:work": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/order-worker.ts",
    "loyalty:work": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/loyalty-worker.ts",
    "breaks:work": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/break-worker.ts",
    "store:assets": "node scripts/store-assets.mjs",
    "notifications:work": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/notification-worker.ts",
    "measurement:work": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/measurement-worker.ts",
    "pwa:assets": "node scripts/pwa-assets.mjs",
    "smoke:production": "node scripts/release-smoke.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node scripts/check-client-secrets.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/supabase-js": "2.116.0",
    "csv-parse": "7.0.2",
    "lucide-react": "1.44.0",
    "next": "16.3.5",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "web-push": "3.6.7",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "type": "module"
}
