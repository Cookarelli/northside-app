{
  "name": "northside-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:customer": "pnpm --filter @northside/customer dev",
    "dev:control": "pnpm --filter @northside/control dev",
    "worker": "node --import tsx apps/worker/src/main.ts",
    "test": "vitest run && pnpm --filter @northside/customer test",
    "typecheck": "tsc --noEmit && pnpm --filter @northside/customer typecheck",
    "build": "pnpm --filter @northside/customer build && pnpm --filter @northside/control build",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "qr": "node --import tsx scripts/generate-qr.ts",
    "test:core": "vitest run",
    "lint": "eslint apps/control packages scripts tests && pnpm --filter @northside/customer lint"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/qrcode": "1.5.5",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "@types/pngjs": "6.0.5",
    "@electric-sql/pglite": "0.5.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "zod": "4.1.12"
  },
  "type": "module"
}
