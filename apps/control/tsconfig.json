{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "paths": {
      "@northside/data": [
        "../../packages/data/src/index.ts"
      ],
      "@northside/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@northside/shopify": [
        "../../packages/shopify/src/index.ts"
      ],
      "@northside/agent-runtime": [
        "../../packages/agent-runtime/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
