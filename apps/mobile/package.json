{
  "name": "@northside/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check:dependencies": "expo install --check",
    "doctor": "expo-doctor",
    "build:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-build.ts",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@northside/customer-contracts": "file:../../packages/customer-contracts",
    "expo": "58.0.23",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.6",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "react-server-dom-webpack": "19.3.0",
    "test-renderer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "expect": "30.5.2"
  }
}
