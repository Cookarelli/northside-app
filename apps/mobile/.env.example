# Public build-time configuration only. No Shopify, SQL, customer or worker secrets.
MOBILE_APP_VARIANT=development
# Leave origins empty until an approved, publicly reachable HTTPS mobile backend is deployed.
# Only public URLs/IDs below. Server credentials belong exclusively in backend secret storage.
MOBILE_DEVELOPMENT_API_ORIGIN=
MOBILE_PREVIEW_API_ORIGIN=
MOBILE_PRODUCTION_API_ORIGIN=
# eas.json supplies registered iOS preview and production values.
# Development identifiers and Android packages still need approval.
MOBILE_DEVELOPMENT_IOS_BUNDLE_ID=
MOBILE_DEVELOPMENT_ANDROID_PACKAGE=
MOBILE_DEVELOPMENT_SCHEME=
MOBILE_PREVIEW_IOS_BUNDLE_ID=
MOBILE_PREVIEW_APPLE_TEAM_ID=
MOBILE_PREVIEW_ANDROID_PACKAGE=
MOBILE_PREVIEW_SCHEME=
MOBILE_PRODUCTION_IOS_BUNDLE_ID=
MOBILE_PRODUCTION_APPLE_TEAM_ID=
MOBILE_PRODUCTION_ANDROID_PACKAGE=
MOBILE_PRODUCTION_SCHEME=
# Organization-owned EAS linkage supplied only after approval.
MOBILE_EXPO_OWNER=
MOBILE_EAS_PROJECT_ID=
MOBILE_IDENTIFIERS_APPROVED=false
