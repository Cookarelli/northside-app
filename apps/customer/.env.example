# Fixtures are development-only and never combine with real authentication.
NORTHSIDE_FIXTURES=1
# Real auth: disable fixtures and use the same registered HTTPS origin everywhere.
APP_ORIGIN=
SESSION_ENCRYPTION_KEY=
# Separate least-privileged DB roles; SSL required on hosted connections.
DATABASE_URL=
AUTH_DATABASE_URL=
# Migration credentials are for the migration CLI only; never deployment runtime.
MIGRATION_DATABASE_URL=
SUPABASE_URL=https://zuqktfohxqzkzumtqibg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret for invitation and already-authorized Storage objects.
SUPABASE_SECRET_KEY=
SHOPIFY_SHOP=9i3hnb-jw.myshopify.com
SHOPIFY_CUSTOMER_CLIENT_ID=
SHOPIFY_CUSTOMER_CLIENT_SECRET=
# Exact issuer from the store's discovery document; independently verify shop ID.
SHOPIFY_EXPECTED_ISSUER=https://shopify.com/authentication/103967392113
# Comma-separated additional hosts from reviewed Shopify discovery metadata.
SHOPIFY_AUTH_HOSTS=
# Prompt 3: private server token from the selected Headless storefront.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Dedicated role northside_commerce, never auth/runtime/migration credentials.
COMMERCE_DATABASE_URL=
# Exact request header overwritten by the verified trusted ingress; no arbitrary forwarded IPs.
SHOPIFY_TRUSTED_BUYER_IP_HEADER=
# Additional exact checkout domains verified from Shopify; never wildcard user input.
SHOPIFY_CHECKOUT_HOSTS=
# Choose only after reviewing the actual installation; see SETUP-PROMPT-3.md.
# installed_oauth OR same_org_client_credentials
SHOPIFY_ADMIN_AUTH_MODE=
SHOPIFY_SAME_ORG_CONFIRMED=false
SHOPIFY_APP_CLIENT_ID=
# Also verifies raw-body webhook HMAC; belongs to the installed app.
SHOPIFY_APP_CLIENT_SECRET=
# installed_oauth only: rotate through supported installation/token broker, with explicit expiry.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_TOKEN_EXPIRES_AT=
# Prompt 6: separate northside_loyalty SQL role, no session/token/operational-card access.
LOYALTY_DATABASE_URL=
# Exact invited staff membership UUID verified privately as Joey. No default approver.
LOYALTY_APPROVER_STAFF_ID=
# Set true only after an authorized checkout test; record evidence in docs. Code gates still remain off.
SHOPIFY_LOYALTY_CHECKOUT_VERIFIED=false
# Prompt 7: verified real test-store last-spot checkouts; local simulation is insufficient.
SHOPIFY_BREAK_CHECKOUT_VERIFIED=false

# Prompt 8: eventual exact HTTPS app origin, no trailing slash. Does not activate public scanning.
NORTHSIDE_QR_ORIGIN=

# Prompt 9 — private engagement worker connection (northside_engagement role only)
ENGAGEMENT_DATABASE_URL=
# Independent random 32-byte base64 key, stored privately; do not reuse session key
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_DELIVERY_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Real mailto: or HTTPS contact required by VAPID; do not use localhost
WEB_PUSH_SUBJECT=
HOBBY_KEY_INTEREST_ENABLED=false
