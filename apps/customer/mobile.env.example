# Backend-only ADDITIONS. Combine privately with the existing customer backend environment.
# Copy selected values into the STAGING secret manager, never into apps/mobile or EXPO_PUBLIC_*.
NORTHSIDE_MOBILE_ENVIRONMENT=staging
# Exact allowlist entries; leave unset until company-approved scheme is registered in a native build.
NORTHSIDE_MOBILE_DEVELOPMENT_RETURN_URI=
NORTHSIDE_MOBILE_PREVIEW_RETURN_URI=
# Use only on a SEPARATE production origin after acceptance; never mix staging and production.
NORTHSIDE_MOBILE_PRODUCTION_RETURN_URI=
# Existing required server settings (names only; use isolated staging values):
# APP_ORIGIN=https://<approved-public-staging-host>
# NORTHSIDE_FIXTURES=0
# SHOPIFY_SHOP=9i3hnb-jw.myshopify.com
# SHOPIFY_EXPECTED_ISSUER=<verified Shopify discovery issuer>
# SHOPIFY_CUSTOMER_CLIENT_ID=<configured confidential customer-account client>
# SHOPIFY_CUSTOMER_CLIENT_SECRET=<server-only secret>
# SESSION_ENCRYPTION_KEY=<stable staging-only 32-byte base64 key>
# DATABASE_URL=<northside_runtime role; verified TLS>
# AUTH_DATABASE_URL=<northside_auth role; verified TLS>
# NORTHSIDE_DATABASE_CA_CERT=<provider CA PEM if required>
# SHOPIFY_API_VERSION=2026-07
# MIGRATION_DATABASE_URL belongs only in a private operator migration environment.
# Do not add staff/bootstrap/Admin/service-role credentials for native authentication.
