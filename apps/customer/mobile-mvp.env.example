# Backend-only additions for the native customer MVP. Leave unset until approved.
# Existing mobile.env.example still supplies auth/origin/restricted SQL settings.
# Shopify collection membership is explicit public product approval; publication alone is insufficient.
NORTHSIDE_MOBILE_APPROVED_COLLECTION=
# Published release products must ALSO belong to the approved collection above.
NORTHSIDE_MOBILE_RELEASE_COLLECTION=
# Singles New Arrivals is a separate curated feed, never inferred from a title,
# creation date, price, quantity, or absence from sealed/graded collections.
# Both handles require operator approval. Products must also be in the approved
# catalog above and retain ns:merchandising:new-arrival-verified.
# The configured Storefront token needs unauthenticated_read_product_tags for
# this opt-in feed only. Existing catalog/detail/scanner do not request tags.
# Collection ordering is Shopify's configured order, not an inferred arrival date.
NORTHSIDE_MOBILE_NEW_ARRIVALS_COLLECTION=
NORTHSIDE_MOBILE_SINGLES_COLLECTION=
# New native read-only scanner approval, NOT the existing web store/checkout flags.
NORTHSIDE_MOBILE_SCAN_READS_APPROVED=false
# Exact existing Northside QR origin; no trailing slash, query, credentials or path.
NORTHSIDE_QR_ORIGIN=
# Operator-reviewed public store information only. No guessed location/hours.
# Example SHAPE ONLY: {"address":"<verified address>","hours":["<verified hours>"],"phone":"<verified phone>"}
NORTHSIDE_MOBILE_STORE_INFO_JSON=
# HTTPS URLs on the approved backend or Northside company website only.
NORTHSIDE_MOBILE_PRIVACY_URL=
NORTHSIDE_MOBILE_DELETION_URL=
NORTHSIDE_MOBILE_SUPPORT_URL=
# Optional verified published Northside events use existing server-only ENGAGEMENT_DATABASE_URL.
# All SQL, Shopify private tokens and session secrets stay on the backend, never EAS/mobile.
# Apply the new privacy migration only after isolated staging/operator review.
