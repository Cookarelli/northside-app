{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@northside/data": [
        "./packages/data/src/index.ts"
      ],
      "@northside/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@northside/shopify": [
        "./packages/shopify/src/index.ts"
      ],
      "@northside/agent-runtime": [
        "./packages/agent-runtime/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/.next",
    "apps/shopify-extension",
    "apps/customer"
  ]
}
